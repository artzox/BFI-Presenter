#include <windows.h>
1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION MGR_VER_NUM
PRODUCTVERSION MGR_VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "artzox"
      VALUE "FileDescription", "BFI Presenter Manager"
      VALUE "FileVersion", MGR_VER_STR
      VALUE "ProductName", "BFI Presenter Manager"
      VALUE "ProductVersion", MGR_VER_STR
      VALUE "LegalCopyright", "Copyright (C) 2026 artzox. GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
