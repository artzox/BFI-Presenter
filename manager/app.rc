#include <windows.h>
1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "artzox"
      VALUE "FileDescription", "BFI Presenter Manager"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "BFI Presenter Manager"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "Copyright (C) 2026 artzox. GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
