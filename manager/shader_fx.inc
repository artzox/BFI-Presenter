// ---------------------------------------------------------------- colour

int OutType()          // 0 SDR, 1 scRGB, 2 HDR10
{
    if (bfi_output == 1) return 0;
    if (bfi_output == 2) return 1;
    if (bfi_output == 3) return 2;
#if BUFFER_COLOR_SPACE == 2
    return 1;
#elif BUFFER_COLOR_SPACE == 3
    return 2;
#else
    return 0;
#endif
}

float3 SrgbToLin(float3 c) { c = max(c, 0.0); return lerp(c / 12.92, pow((c + 0.055) / 1.055, 2.4), step(0.04045, c)); }
float3 LinToSrgb(float3 l) { l = max(l, 0.0); return lerp(l * 12.92, 1.055 * pow(l, 1.0 / 2.4) - 0.055, step(0.0031308, l)); }
static const float PQ_M1 = 0.1593017578125, PQ_M2 = 78.84375, PQ_C1 = 0.8359375, PQ_C2 = 18.8515625, PQ_C3 = 18.6875;
float3 PqToLin(float3 e)       // 1.0 = 80 nits
{
    float3 p = pow(saturate(e), 1.0 / PQ_M2);
    return pow(max(p - PQ_C1, 0.0) / (PQ_C2 - PQ_C3 * p), 1.0 / PQ_M1) * (10000.0 / 80.0);
}
float3 LinToPq(float3 l)
{
    float3 p = pow(saturate(max(l, 0.0) * (80.0 / 10000.0)), PQ_M1);
    return pow((PQ_C1 + PQ_C2 * p) / (1.0 + PQ_C3 * p), PQ_M2);
}
float3 Decode(float3 c, int t) { if (t == 0) return SrgbToLin(c); if (t == 2) return PqToLin(c); return c; }
float3 Encode(float3 l, int t) { if (t == 0) return saturate(LinToSrgb(l)); if (t == 2) return LinToPq(l); return l; }

// ---------------------------------------------------------------- strobe (same maths as the add-on)

int  Frames()   { return clamp(bfi_frames, 2, 8); }
bool Inverted() { return bfi_invert && Frames() > 2; }
float LitGain() { int n = Frames(); return Inverted() ? float(n) * bfi_gain / float(n - 1) : float(n) * bfi_gain; }

float Target(int j, float litGain, float fl)
{
    int n = Frames();
    if (bfi_sine)
    {
        float ph = (float(j) / float(n)) * 6.28318531;
        if (Inverted()) ph += 3.14159265;
        return lerp(fl, litGain, 0.5 + 0.5 * cos(ph));
    }
    bool lit = Inverted() ? (j != 0) : (j == 0);
    return lit ? litGain : fl;
}

float3 Rolloff(float3 lin, float g, float P, float k)
{
    float m = max(max(lin.r, lin.g), lin.b);
    float3 r = lin * g;
    if (g > 1.0 && m > 1e-6)
    {
        float u = m / P;
        float v = g * u;
        k = clamp(k, 0.05, 0.99);
        if (u >= 1.0)
            r = lin;
        else if (v > k)
        {
            float a = (g - k) / (1.0 - k);
            float t = saturate((v - k) / (g - k));
            float o = k + (1.0 - k) * (1.0 - pow(1.0 - t, a));
            r = lin * (o / u);
        }
    }
    return r;
}

float MprtScale(int k, float litGain, float fl, float S)
{
    int n = Frames();
    int k0 = 0;
    if (Inverted()) k0 = bfi_sine ? (n / 2) : 1;
    int pos = (k + n - k0) % n;
    float fill0 = 0.0, fill1 = 0.0, fill2 = 0.0, fill3 = 0.0, fill4 = 0.0, fill5 = 0.0, fill6 = 0.0, fill7 = 0.0;
    float carry = 0.0;
    [unroll] for (int j = 0; j < 8; j++)
    {
        float f = 0.0;
        if (j < n)
        {
            float want = Target((k0 + j) % n, litGain, fl) + carry;
            f = min(want, S);
            carry = want - f;
        }
        if (j == 0) fill0 = f; else if (j == 1) fill1 = f; else if (j == 2) fill2 = f; else if (j == 3) fill3 = f;
        else if (j == 4) fill4 = f; else if (j == 5) fill5 = f; else if (j == 6) fill6 = f; else fill7 = f;
    }
    float s = 0.0;
    [unroll] for (int j2 = 0; j2 < 8; j2++)
    {
        float f = (j2 == 0) ? fill0 : (j2 == 1) ? fill1 : (j2 == 2) ? fill2 : (j2 == 3) ? fill3 :
                  (j2 == 4) ? fill4 : (j2 == 5) ? fill5 : (j2 == 6) ? fill6 : fill7;
        if (j2 < n)
        {
            float add = min(carry, S - f);
            carry -= add;
            if (j2 == pos) s = f + add;
        }
    }
    return s;
}

float3 Strobe(float3 lin, int j, float litGain, float ceilLin)
{
    if (bfi_method == 0)
    {
        float g = Target(j, litGain, bfi_floor);
        return bfi_rolloff ? Rolloff(lin, g, ceilLin, bfi_knee) : lin * g;
    }
    float m = max(max(lin.r, lin.g), lin.b);
    float S = (m > 1e-6) ? max(ceilLin / m, 1.0) : 1e6;
    return lin * MprtScale(j, litGain, bfi_floor, S);
}

float DecayShare(int s, float phi, float T, float n)
{
    float a = float(s) - phi;
    a = a - n * floor(a / n);
    float norm = 1.0 - exp(-n / T);
    float b = a + 1.0;
    if (b <= n) return (exp(-a / T) - exp(-b / T)) / norm;
    return (exp(-a / T) - exp(-n / T) + 1.0 - exp(-(b - n) / T)) / norm;
}

// ---------------------------------------------------------------- passes

void PostProcessVS_BFI(in uint id : SV_VertexID, out float4 pos : SV_Position, out float2 uv : TEXCOORD)
{
    uv.x = (id == 2) ? 2.0 : 0.0;
    uv.y = (id == 1) ? 2.0 : 0.0;
    pos = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
}

#if BFI_ABL
// Lit-refresh luminance of each cell at the full ceiling (4x4 samples per cell), in nits.
float CellsPS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    int t = OutType();
    float ceilLin = (t == 0) ? 1.0 : bfi_peak / 80.0;
    float litGain = LitGain();
    float2 cell = float2(BUFFER_WIDTH, BUFFER_HEIGHT) / float2(32.0, 18.0);
    float sum = 0.0;
    [unroll] for (int y = 0; y < 4; y++)
    [unroll] for (int x = 0; x < 4; x++)
    {
        float2 p = (floor(pos.xy) + (float2(x, y) + 0.5) / 4.0) * cell;
        float3 lin = max(Decode(tex2Dlod(BFI_BackBuffer, float4(p / float2(BUFFER_WIDTH, BUFFER_HEIGHT), 0, 0)).rgb, t), 0.0);
        float m = max(max(lin.r, lin.g), lin.b);
        float S = (m > 1e-6) ? max(ceilLin / m, 1.0) : 1e6;
        sum += dot(lin, float3(0.2126, 0.7152, 0.0722)) * min(litGain, S);
    }
    return sum / 16.0 * 80.0;
}

float AvgAt(float C)
{
    float a = 0.0;
    for (int y = 0; y < 18; y++)
        for (int x = 0; x < 32; x++)
            a += min(tex2Dfetch(bfi_cells, int2(x, y)).r, C);
    return a / (32.0 * 18.0);
}
#endif

// Hitch guard and ABL guard state, one pixel.
float4 StatePS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float ft = clamp(BFI_FRAMETIME, 0.0, 1000.0);
    float now = BFI_TIMER;
    float P = 1000.0 / max(bfi_refresh, 1.0);
    // Refresh drift: frame time minus one refresh, summed (with a slow leak
    // for a display at 119.9 instead of 120 Hz). CPU-measured frame times
    // jitter in long/short pairs that cancel out; a missed refresh moves the
    // sum by a whole refresh and keeps it there, a game faster than the
    // display pulls it down every frame.
    float d = tex2Dfetch(bfi_state2, int2(1, 0)).x;
    if (abs(d) > 1000.0) d = 0.0;
    d = (d + ft - P) * 0.99;
    bool missed = false;
    if (d >  bfi_hitch_tol * P) { missed = true; d -= P; }
    if (d < -bfi_hitch_tol * P) { missed = true; d += P; }
    if (pos.x >= 1.0) return float4(d, 0.0, 0.0, 0.0);

    float4 st = tex2Dfetch(bfi_state2, int2(0, 0));
    if (st.y <= 0.0 || st.y > 1000.0) st.y = P;                       // first frame
    st.y = lerp(st.y, min(ft, 100.0), 0.05);
    // ... or the average off by 10 %: the game doesn't run at the refresh rate.
    bool bad = missed || ft > 3.0 * P || abs(st.y - P) > 0.1 * P || now < 2000.0;
    if (bad) st.x = now + bfi_hitch_hold;
    if (st.x > now + 10000.0) st.x = now;                             // timer restarted

    // ABL guard: the highest ceiling at which the lit refresh averages no
    // more than the budget; pulled down fast, released only after 1.5 s under
    // budget and then slowly (a quick release bounces off the panel's limiter).
    float target = bfi_peak;
#if BFI_ABL
    if (bfi_abl && OutType() != 0 && bfi_enabled)
    {
        if (AvgAt(bfi_peak) > bfi_abl_budget)
        {
            float lo = 100.0, hi = bfi_peak;
            for (int it = 0; it < 14; it++)
            {
                float mid = 0.5 * (lo + hi);
                if (AvgAt(mid) <= bfi_abl_budget) lo = mid; else hi = mid;
            }
            target = lo;
        }
    }
#endif
    float dt = clamp(ft, 0.0, 100.0) / 1000.0;
    if (st.z <= 0.0 || st.z > bfi_peak) st.z = target;
    else if (target < st.z - 5.0) { st.w = now; st.z += (target - st.z) * (1.0 - exp(-dt / 0.08)); }
    else if (now - st.w > 1500.0)  st.z += (target - st.z) * (1.0 - exp(-dt / 2.5));
    return st;
}

float4 CopyStatePS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    return tex2Dfetch(bfi_state, int2(0, 0));
}

float4 StrobePS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float4 c = tex2D(BFI_BackBuffer, uv);
    if (!bfi_enabled) return c;
    float4 st = tex2Dfetch(bfi_state, int2(0, 0));
    int t = OutType();
    int n = Frames();
    float3 lin = Decode(c.rgb, t);
    float litGain = LitGain();
    float ceilLin = (t == 0) ? 1.0 : floor(st.z / 10.0 + 0.5) * 10.0 / 80.0;
    int slot = int(BFI_FRAMECOUNT % uint(n));
    bool paused = bfi_hitch && BFI_TIMER < st.x;
    float3 o;
    if (paused)
    {
        float a = 0.0;
        [unroll] for (int j = 0; j < 8; j++) if (j < n) a += Target(j, litGain, bfi_floor);
        o = lin * (a / float(n));
    }
    else if (bfi_rolling && bfi_decay > 0.0)
    {
        float fn = float(n);
        float phi = (pos.y / float(BUFFER_HEIGHT)) * fn;
        float T = max(bfi_decay, 0.02);
        o = 0.0;
        [unroll] for (int j = 0; j < 8; j++)
        {
            if (j < n)
            {
                int d = (slot + n - j) % n;
                float e = DecayShare(d, phi, T, fn);
                if (e > 1e-5) o += Strobe(lin, j, litGain, ceilLin) * e;
            }
        }
    }
    else if (bfi_rolling)
    {
        float u = (pos.y / float(BUFFER_HEIGHT)) * float(n);
        int band = min(int(u), n - 1);
        float f = u - float(band);
        float hw = max(bfi_seam * float(n) * 0.5, 1e-4);
        o = Strobe(lin, (slot + n - band) % n, litGain, ceilLin);
        float wn = 0.0; int nb = band;
        if (f < hw && band > 0)                     { wn = 0.5 * (1.0 - f / hw);         nb = band - 1; }
        else if (1.0 - f < hw && band + 1 < n)      { wn = 0.5 * (1.0 - (1.0 - f) / hw); nb = band + 1; }
        if (wn > 0.0) o = lerp(o, Strobe(lin, (slot + n - nb) % n, litGain, ceilLin), wn);
    }
    else o = Strobe(lin, slot, litGain, ceilLin);

    float4 r = float4(Encode(o, t), c.a);
    if (bfi_show_status && pos.x < 24.0 && pos.y < 24.0)
    {
        float P = 1000.0 / max(bfi_refresh, 1.0);
        float3 col = (abs(st.y - P) > 0.1 * P) ? float3(1.0, 0.1, 0.1) : paused ? float3(1.0, 0.7, 0.0) : float3(0.1, 1.0, 0.2);
        r.rgb = Encode(col * ((t == 0) ? 1.0 : 2.5), t);
    }
    return r;
}

technique BFIPresenter_Shader <
    ui_label = "BFI Presenter (shader)";
    ui_tooltip = "Black frame insertion clocked by the game's frames, for games that hold a locked\n"
                 "frame rate equal to the refresh rate. Put it last in the list. Don't use it\n"
                 "together with the BFI Presenter add-on.";
>
{
#if BFI_ABL
    pass Cells  { VertexShader = PostProcessVS_BFI; PixelShader = CellsPS;     RenderTarget = bfi_cells_tex; }
#endif
    pass State  { VertexShader = PostProcessVS_BFI; PixelShader = StatePS;     RenderTarget = bfi_state_tex; }
    pass Keep   { VertexShader = PostProcessVS_BFI; PixelShader = CopyStatePS; RenderTarget = bfi_state2_tex; }
    pass Strobe { VertexShader = PostProcessVS_BFI; PixelShader = StrobePS; }
}
)BFIFX";
